<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Vantix — Login</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
    :root {
        --bg: #000000;
        --panel: #050505;
        --border: #222222;
        --text: #FFFFFF;
        --text2: #A1A1AA;
        --cyan: #00E5FF;
        --green: #00FF88;
        --red: #FF2266;
        --violet: #8B7FFF;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        background-color: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        height: 100vh;
        display: flex;
        overflow: hidden;
        background-image: 
            linear-gradient(rgba(0, 229, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 229, 255, 0.03) 1px, transparent 1px);
        background-size: 50px 50px;
        background-position: center;
    }

    /* LEFT SIDE - VISUALS */
    .login-left {
        flex: 1.2;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        border-right: 1px solid var(--border);
    }
    
    /* Glowing Center Orb */
    .glow-orb {
        position: absolute;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(0, 229, 255, 0.1) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: pulse 4s infinite alternate;
    }
    @keyframes pulse { 
        0% { transform: scale(1); opacity: 0.5; } 
        100% { transform: scale(1.2); opacity: 1; } 
    }

    /* Floating UI Cards */
    .float-card {
        position: absolute;
        background: rgba(10, 10, 10, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid var(--border);
        padding: 16px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        transition: transform 0.1s ease-out;
        width: 280px;
        z-index: 10;
    }
    .float-card-header {
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
    }
    .float-card-body { font-size: 13px; line-height: 1.5; color: var(--text2); }
    
    /* Card Positions */
    .card-1 { top: 15%; left: 10%; }
    .card-2 { top: 40%; right: 10%; width: 300px; }
    .card-3 { bottom: 15%; left: 15%; }

    .stat-value { font-family: 'JetBrains Mono', monospace; font-size: 24px; font-weight: 800; }
    .stat-green { color: var(--green); }
    .stat-red { color: var(--red); }
    .stat-cyan { color: var(--cyan); }
    .stat-violet { color: var(--violet); }

    /* RIGHT SIDE - AUTH */
    .login-right {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
        padding: 40px;
        position: relative;
        z-index: 20;
    }
    .login-box {
        width: 100%;
        max-width: 420px;
        background: var(--panel);
        border: 1px solid var(--border);
        padding: 48px 40px;
        text-align: center;
        box-shadow: 0 0 50px rgba(0, 229, 255, 0.05);
    }
    
    .login-logo { margin-bottom: 24px; }
    .login-logo svg { width: 64px; height: 64px; }
    
    .login-box h1 {
        font-size: 28px;
        font-weight: 900;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }
    .login-box p {
        font-size: 13px;
        color: var(--text2);
        margin-bottom: 40px;
    }

    .google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        height: 48px;
        background: #FFFFFF;
        color: #000000;
        border: none;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.2s;
    }
    .google-btn:hover { 
        box-shadow: 0 0 20px rgba(255,255,255,0.2);
        transform: translateY(-1px);
    }
    .google-btn img { width: 20px; height: 20px; }
    .google-btn:disabled { opacity: 0.7; cursor: wait; }

    .error-msg {
        color: var(--red);
        font-size: 12px;
        margin-top: 16px;
        display: none;
        font-weight: 600;
    }

    @media (max-width: 900px) {
        body { flex-direction: column; overflow-y: auto; background-size: 30px 30px; }
        .login-left { display: none; /* Hide visuals on mobile to save space */ }
        .login-right { padding: 24px; min-height: 100vh; }
        .login-box { padding: 32px 24px; }
    }
</style>
</head>
<body>

    <!-- LEFT SIDE - FLOATING VISUALS -->
    <div class="login-left">
        <div class="glow-orb"></div>

        <!-- Card 1: Price War -->
        <div class="float-card card-1" data-speed="2">
            <div class="float-card-header">
                <span style="color: var(--amber);">⚔️ Price War Safe Floor</span>
                <span style="color: var(--text2);">LIVE</span>
            </div>
            <div class="float-card-body">
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span>Your Cost</span> <span class="stat-value" style="font-size:14px;">$11.59</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                    <span>Safe Floor</span> <span class="stat-value stat-cyan" style="font-size:14px;">$13.63</span>
                </div>
                <div class="stat-value stat-red" style="font-size: 16px; text-align: center; border-top: 1px solid #333; padding-top: 8px;">DO NOT MATCH</div>
            </div>
        </div>

        <!-- Card 2: AI Advisor -->
        <div class="float-card card-2" data-speed="3">
            <div class="float-card-header">
                <span style="color: var(--violet);">🧠 AI Margin Advisor</span>
                <span style="color: var(--text2);">GROQ</span>
            </div>
            <div class="float-card-body" style="color: #fff;">
                "HOLD—matching $10 will wipe out profit. Bundle with a premium gym bag to justify $28.97 and keep margins healthy."
            </div>
        </div>

        <!-- Card 3: Competitor Alert -->
        <div class="float-card card-3" data-speed="1.5">
            <div class="float-card-header">
                <span style="color: var(--red);">🚨 Competitor Price Drop</span>
                <span style="color: var(--text2);">2m ago</span>
            </div>
            <div class="float-card-body">
                <div style="font-weight: 800; color: #fff; margin-bottom: 4px;">Seamless Shorts in Midnight Navy</div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <span style="text-decoration: line-through; color: var(--text2);">$45.00</span>
                    <span class="stat-value stat-green">$35.00</span>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE - LOGIN BOX -->
    <div class="login-right">
        <div class="login-box">
            <div class="login-logo">
                <svg viewBox="0 0 32 32"><rect x="0.5" y="0.5" width="31" height="31" fill="#000" stroke="#2A2A2A" stroke-width="1"/><polyline points="6.5,8 14.5,24 24,8" fill="none" stroke="#00E5FF" stroke-width="3.2" stroke-linejoin="miter" stroke-linecap="square"/><rect x="22" y="5.5" width="5" height="5" fill="#00FF88"/></svg>
            </div>
            <h1>Welcome to Vantix</h1>
            <p>Sign in to access your intelligence dashboard.</p>

            <button id="login-btn" class="google-btn">
                <img id="btn-icon" src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google">
                <span id="btn-text">Sign in with Google</span>
            </button>

            <div id="error-msg" class="error-msg"></div>
        </div>
    </div>

<script>
    // 3D Parallax Effect
    document.addEventListener('mousemove', (e) => {
        const x = (window.innerWidth / 2 - e.pageX) / 40;
        const y = (window.innerHeight / 2 - e.pageY) / 40;
        
        document.querySelectorAll('.float-card').forEach(card => {
            const speed = card.getAttribute('data-speed');
            card.style.transform = `translate(${x * speed}px, ${y * speed}px)`;
        });
    });

    // Supabase Auth (Exactly as before)
    document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById('login-btn');
        const btnText = document.getElementById('btn-text');
        const btnIcon = document.getElementById('btn-icon');
        const errorMsg = document.getElementById('error-msg');

        if (!window.supabase) {
            errorMsg.style.display = 'block';
            errorMsg.innerText = "Error: Supabase failed to load. Check your internet connection.";
            return;
        }

        const SUPABASE_URL = "https://odvusqxvhgyfoiyooktl.supabase.co";
        const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9kdnVzcXh2aGd5Zm9peW9va3RsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI5Mzk3NzAsImV4cCI6MjEwODUxNTc3MH0.5LlYHzs4iHz7gQMCLLBCDT7deMveYpx-8fabCH5AljU";

        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        btn.addEventListener('click', async () => {
            try {
                btn.disabled = true;
                btnText.innerText = "Connecting to Google...";
                btnIcon.style.display = 'none';
                errorMsg.style.display = 'none';

                const { data, error } = await supabase.auth.signInWithOAuth({
                    provider: 'google',
                    options: {
                        redirectTo: 'https://robelceo.github.io/vantix-ui/index.html',
                        skipBrowserRedirect: false
                    }
                });

                if (error) throw error;
            } catch (error) {
                btn.disabled = false;
                btnText.innerText = "Sign in with Google";
                btnIcon.style.display = 'block';
                errorMsg.style.display = 'block';
                errorMsg.innerText = "Login failed: " + error.message;
            }
        });
    });
</script>
</body>
</html>
