<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Vantix — Discovery</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
    .category-pills { display: flex; gap: 8px; margin-bottom: 20px; overflow-x: auto; }
    .pill { padding: 8px 16px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 20px; font-size: 12px; font-weight: 700; color: var(--text-tertiary); cursor: pointer; white-space: nowrap; }
    .pill.active { background: var(--accent); color: #000; border-color: var(--accent); }
</style>
</head>
<body>

<div class="drawer-overlay" id="drawer-overlay" onclick="toggleMenu()"></div>
<div class="drawer" id="mobile-drawer">
    <div class="drawer-header">
        <div class="brand"><div>VANTI<span>X</span></div></div>
        <button class="drawer-close" onclick="toggleMenu()">✕</button>
    </div>
    <a href="index.html" class="drawer-tab ">Connect</a>
    <a href="overview.html" class="drawer-tab ">Overview</a>
    <a href="store.html" class="drawer-tab ">My Store</a>
    <a href="competitors.html" class="drawer-tab ">Competitors</a>
    <a href="terminal.html" class="drawer-tab ">Terminal</a>
    <a href="discovery.html" class="drawer-tab active">Discovery</a>
    <a href="alerts.html" class="drawer-tab ">Alerts</a>
    <a href="inventory.html" class="drawer-tab ">Inventory</a>
    <a href="membership.html" class="drawer-tab ">Membership</a>
    <a href="settings.html" class="drawer-tab ">Settings</a>
    
</div>

<div class="header">
    <a href="index.html" class="brand">
        <div class="mark"><svg viewBox="0 0 32 32"><rect x="0.5" y="0.5" width="31" height="31" fill="#000" stroke="#2A2A2A" stroke-width="1"/><polyline points="6.5,8 14.5,24 24,8" fill="none" stroke="#00E5FF" stroke-width="3.2" stroke-linejoin="miter" stroke-linecap="square"/><rect x="22" y="5.5" width="5" height="5" fill="#00FF88"/></svg></div>
        <div>VANTI<span>X</span></div>
    </a>
    <div class="tabs">
        <a href="index.html" class="tab ">Connect</a>
        <a href="overview.html" class="tab ">Overview</a>
        <a href="store.html" class="tab ">My Store</a>
        <a href="competitors.html" class="tab ">Competitors</a>
        <a href="terminal.html" class="tab ">Terminal</a>
        <a href="discovery.html" class="tab active">Discovery</a>
        <a href="alerts.html" class="tab ">Alerts</a>
        <a href="inventory.html" class="tab ">Inventory</a>
        <a href="membership.html" class="tab ">Membership</a>
        <a href="settings.html" class="tab ">Settings</a>
        
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
        <div id="user-email" style="font-size: 11px; color: var(--text-tertiary); font-family: var(--font-mono);">loading...</div>
        <button onclick="logOut()" id="logout-btn" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px; display: none;">Log Out</button>
        <button class="mobile-menu-btn" onclick="toggleMenu()">☰</button>
    </div>
</div>

<div class="screen">
    <div style="max-width: 1100px; margin: 0 auto; padding-top: 20px;">
        <div class="screen-title">Market Goldmines</div>
        <div class="screen-sub">High-demand products dominating the global Shopify ecosystem.</div>

        <!-- GLOBAL SEARCH BAR -->
        <div style="display: flex; gap: 8px; margin-bottom: 16px;">
            <input type="text" id="search-input" class="form-input" placeholder="Search any niche globally (e.g. gaming chairs, skincare, dog toys)..." style="flex: 1;" onkeypress="handleSearch(event)">
            <button onclick="triggerSearch()" class="btn btn-primary" style="padding: 10px 20px;">Search</button>
        </div>

        <!-- SUGGESTED PILLS -->
        <div class="category-pills" id="category-pills">
            <div class="pill active" onclick="switchCategory('')">Auto-Detect</div>
            <div class="pill" onclick="switchCategory('jeans')">Jeans</div>
            <div class="pill" onclick="switchCategory('shorts')">Shorts</div>
            <div class="pill" onclick="switchCategory('activewear')">Activewear</div>
            <div class="pill" onclick="switchCategory('shoes')">Shoes</div>
            <div class="pill" onclick="switchCategory('bags')">Bags</div>
        </div>

        <div id="discovery-container">
            <div class="text-tertiary" style="text-align: center; padding: 40px;">
                <span style="display:inline-block; width:20px; height:20px; border:2px solid var(--accent); border-top-color:transparent; border-radius:50%; animation: spin 1s linear infinite;"></span>
                <div style="margin-top: 12px;">Scanning global Shopify market...</div>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<script src="js/app.js?v=2050"></script>
<script src="js/discovery.js?v=2052"></script>
</body>
</html>



