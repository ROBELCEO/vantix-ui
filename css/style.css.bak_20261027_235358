   ANTI-BOUNCE — keep scroll steady like original
   ========================================== */
html, body {

}
.screen {
    overscroll-behavior: contain;

}


/* ==========================================
   ANTI-BOUNCE — final, definitive
   No touch momentum. No overscroll chain.
   Scroll stays inside .screen only.
   ========================================== */
html, body {
    overflow: hidden;
    overscroll-behavior: none;
    -webkit-overflow-scrolling: auto;
}
.screen {
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: auto;
    scroll-behavior: auto;
}
.ov-screen, .st-screen {
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: auto;
}
