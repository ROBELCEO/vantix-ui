<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Vantix — Competitors</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>

<div class="drawer-overlay" id="drawer-overlay" onclick="toggleMenu()"></div>
<div class="drawer" id="mobile-drawer">
    <div class="drawer-header">
        <div class="brand"><div>VANTI<span>X</span></div></div>
        <button class="drawer-close" onclick="toggleMenu()">✕</button>
    </div>
    <a href="index.html" class="drawer-tab ">Connect</a>
    <a href="overview.html" class="drawer-tab ">Overview</a>
    <a href="store.html" class="drawer-tab ">My Store</a>
    <a href="competitors.html" class="drawer-tab active">Competitors</a>
    <a href="terminal.html" class="drawer-tab ">Terminal</a>
    <a href="discovery.html" class="drawer-tab ">Discovery</a>
    <a href="alerts.html" class="drawer-tab ">Alerts</a>
    <a href="inventory.html" class="drawer-tab ">Inventory</a>
    <a href="membership.html" class="drawer-tab ">Membership</a>
    <a href="settings.html" class="drawer-tab ">Settings</a>
    
</div>

<div class="header">
    <a href="index.html" class="brand">
        <div class="mark"><svg viewBox="0 0 32 32"><rect x="0.5" y="0.5" width="31" height="31" fill="#000" stroke="#2A2A2A" stroke-width="1"/><polyline points="6.5,8 14.5,24 24,8" fill="none" stroke="#00E5FF" stroke-width="3.2" stroke-linejoin="miter" stroke-linecap="square"/><rect x="22" y="5.5" width="5" height="5" fill="#00FF88"/></svg></div>
        <div>VANTI<span>X</span></div>
    </a>
    <div class="tabs">
        <a href="index.html" class="tab ">Connect</a>
        <a href="overview.html" class="tab ">Overview</a>
        <a href="store.html" class="tab ">My Store</a>
        <a href="competitors.html" class="tab active">Competitors</a>
        <a href="terminal.html" class="tab ">Terminal</a>
        <a href="discovery.html" class="tab ">Discovery</a>
        <a href="alerts.html" class="tab ">Alerts</a>
        <a href="inventory.html" class="tab ">Inventory</a>
        <a href="membership.html" class="tab ">Membership</a>
        <a href="settings.html" class="tab ">Settings</a>
        
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
        <div id="user-email" style="font-size: 11px; color: var(--text-tertiary); font-family: var(--font-mono);">loading...</div>
        <button onclick="logOut()" id="logout-btn" class="btn btn-secondary" style="padding: 6px 12px; font-size: 11px; display: none;">Log Out</button>
        <button class="mobile-menu-btn" onclick="toggleMenu()">☰</button>
    </div>
</div>

<div class="screen">
    <div style="max-width: 1100px; margin: 0 auto; padding-top: 20px;">
        
        <div class="screen-title">Competitors</div>
        <div class="screen-sub" id="plan-sub">You are on the TRIAL plan. You can track up to 10 competitors.</div>

        <!-- TOP GRID: DISCOVER & ADD MANUALLY -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
            <div class="panel" style="border-color: rgba(0, 229, 255, 0.4); background: linear-gradient(180deg, rgba(0,229,255,0.05), transparent);">
                <div class="panel-header" style="color: var(--accent);">✨ Auto-Discover Competitors</div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">Let AI analyze your Shopify products and find the top competing stores in your exact niche.</div>
                <button class="btn btn-primary" style="width: 100%;" onclick="autoDiscover()">Find My Competitors →</button>
            </div>
            
            <div class="panel">
                <div class="panel-header">Add Manually</div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">Enter a public Shopify store domain.</div>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="comp-domain" class="form-input" placeholder="competitor.com" style="flex: 1;">
                    <button class="btn btn-secondary" onclick="addCompetitor()">Add</button>
                </div>
            </div>
        </div>

        <!-- TRACKED COMPETITORS LIST -->
        <div class="panel" style="margin-bottom: 24px;">
            <div class="panel-header">Tracked Competitors</div>
            <div id="competitors-list">
                <div class="text-tertiary" style="font-size: 12px;">Loading...</div>
            </div>
        </div>

        <!-- THE SPY NETWORK (4 FEATURES) -->
        <div class="screen-title" style="font-size: 20px; margin-top: 40px; margin-bottom: 16px;">🕵️ Spy Network</div>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
            <!-- STOCK OUT RADAR -->
            <div class="panel" style="border-color: rgba(255, 170, 0, 0.4); background: linear-gradient(180deg, rgba(255,170,0,0.05), transparent);">
                <div class="panel-header" style="color: var(--amber); display: flex; justify-content: space-between;">
                    <div>🚨 Stock-Out Radar</div>
                    <div class="badge badge-red">Opportunity</div>
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">Competitors who are out of stock. Run ads now.</div>
                <div id="stockout-list"><div class="text-tertiary" style="font-size: 12px; text-align: center;">Scanning...</div></div>
            </div>

            <!-- NEW LAUNCH TRACKER -->
            <div class="panel" style="border-color: rgba(0, 255, 136, 0.4); background: linear-gradient(180deg, rgba(0,255,136,0.05), transparent);">
                <div class="panel-header" style="color: var(--green); display: flex; justify-content: space-between;">
                    <div>🚀 New Launch Tracker</div>
                    <div class="badge badge-green">Last 30 Days</div>
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">Products your competitors recently launched.</div>
                <div id="launch-list"><div class="text-tertiary" style="font-size: 12px; text-align: center;">Scanning...</div></div>
            </div>
        </div>

        <!-- CATALOG GAP ANALYZER -->
        <div class="panel" style="border-color: rgba(139, 127, 255, 0.4); background: linear-gradient(180deg, rgba(139,127,255,0.05), transparent);">
            <div class="panel-header" style="color: var(--violet); display: flex; justify-content: space-between;">
                <div>🧩 Catalog Gap Analyzer</div>
                <div class="badge badge-violet">Missed Revenue</div>
            </div>
            <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">Items your competitors sell, but you don't.</div>
            <div id="gap-list" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="text-tertiary" style="font-size: 12px; text-align: center;">Scanning catalogs...</div>
            </div>
        </div>

    </div>
</div>

<script src="js/app.js?v=2050"></script>
<script src="js/competitors.js?v=2022"></script>
</body>
</html>
