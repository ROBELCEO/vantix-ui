<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Vantix — Login</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css?v=2079">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
    :root {
        --bg: #000000;
        --panel: #080808;
        --border: #222222;
        --text: #FFFFFF;
        --text2: #A1A1AA;
        --cyan: #00E5FF;
        --green: #00FF88;
        --red: #FF2266;
        --violet: #8B7FFF;
        --amber: #FFAA00;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        background-color: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        height: 100vh;
        display: flex;
        overflow: hidden;
    }

    /* LEFT SIDE - CHAT */
    .chat-container {
        flex: 1.2;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--border);
        background-image: 
            linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 40px 40px;
    }
    
    .chat-header {
        padding: 20px 32px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
        background: var(--panel);
    }
    .chat-header svg { width: 28px; height: 28px; }
    .chat-header-title {
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 1px;
    }
    .chat-header-title span { color: var(--cyan); }
    .chat-status {
        margin-left: auto;
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        color: var(--green);
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .chat-status::before {
        content: '';
        width: 6px;
        height: 6px;
        background: var(--green);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--green);
    }

    .chat-messages {
        flex: 1;
        min-height: 0; /* CRITICAL FIX: Stops the chat from pushing the right side */
        padding: 32px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
        scroll-behavior: smooth;
    }

    /* Message Bubbles */
    .msg {
        display: none; /* Hidden by default, JS reveals them */
        flex-direction: column;
        gap: 6px;
        max-width: 85%;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .msg.show {
        display: flex;
        opacity: 1;
        transform: translateY(0);
    }
    
    .msg-sender {
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        color: var(--text2);
        text-transform: uppercase;
    }
    .msg-sender.system { color: var(--cyan); }
    
    .msg-bubble {
        background: var(--panel);
        border: 1px solid var(--border);
        padding: 16px;
        font-size: 13px;
        line-height: 1.6;
        color: var(--text2);
    }
    .msg-bubble strong { color: #fff; }

    /* Mock UI Images inside Chat */
    .mock-ui {
        border: 1px solid var(--border);
        background: #000;
        padding: 12px;
        margin-top: 8px;
    }
    .mock-header {
        display: flex;
        justify-content: space-between;
        font-size: 9px;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 8px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
    }
    .mock-row {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        margin-bottom: 4px;
    }
    .mock-val { font-family: 'JetBrains Mono', monospace; font-weight: 800; }

    /* Typing Indicator */
    .typing-indicator {
        display: none;
        gap: 4px;
        padding: 12px 16px;
        background: var(--panel);
        border: 1px solid var(--border);
        width: fit-content;
    }
    .typing-indicator.show { display: flex; }
    .typing-dot {
        width: 6px;
        height: 6px;
        background: var(--text2);
        border-radius: 50%;
        animation: typing 1.4s infinite ease-in-out both;
    }
    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }
    @keyframes typing {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }

    /* RIGHT SIDE - LOGIN */
    .login-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        background: var(--bg);
        overflow-y: auto; /* Allows login box to scroll if screen is too short */
    }
    
    .login-box {
        width: 100%;
        max-width: 400px;
        background: var(--panel);
        border: 1px solid var(--border);
        padding: 40px;
    }
    
    .login-box h1 {
        font-size: 22px;
        font-weight: 900;
        margin-bottom: 8px;
    }
    .login-box p {
        font-size: 13px;
        color: var(--text2);
        margin-bottom: 32px;
        line-height: 1.5;
    }

    .google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        height: 48px;
        background: #FFFFFF;
        color: #000000;
        border: none;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.2s;
    }
    .google-btn:hover { 
        background: var(--cyan);
        box-shadow: 0 0 20px rgba(0, 229, 255, 0.3);
    }
    .google-btn img { width: 18px; height: 18px; }

    .error-msg {
        color: var(--red);
        font-size: 12px;
        margin-top: 16px;
        display: none;
        font-weight: 600;
    }

    @media (max-width: 900px) {
        body { 
            flex-direction: column; 
            height: auto; 
            overflow-y: auto; 
        }
        .chat-container { 
            border-right: none; 
            border-bottom: 1px solid var(--border); 
            height: 50vh; 
            min-height: 400px;
        }
        .chat-messages { padding: 16px; }
        .login-container { 
            min-height: 50vh; 
            padding: 40px 20px; 
        }
        .msg { max-width: 100%; }
    }
        .login-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        background: var(--bg);
        overflow-y: auto; /* Allows login box to scroll if screen is too short */
    }
        .msg { max-width: 100%; }
    }
</style>
</head>
<body>

    <!-- LEFT SIDE - CHAT ONBOARDING -->
    <div class="chat-container">
        <div class="chat-header">
            <svg viewBox="0 0 32 32"><rect x="0.5" y="0.5" width="31" height="31" fill="#000" stroke="#2A2A2A" stroke-width="1"/><polyline points="6.5,8 14.5,24 24,8" fill="none" stroke="#00E5FF" stroke-width="3.2" stroke-linejoin="miter" stroke-linecap="square"/><rect x="22" y="5.5" width="5" height="5" fill="#00FF88"/></svg>
            <div class="chat-header-title">VANTIX <span>SYSTEM</span></div>
            <div class="chat-status">CONNECTING</div>
        </div>

        <div class="chat-messages" id="chat-box">
            <div class="msg" id="msg-1">
                <div class="msg-sender system">Vantix System</div>
                <div class="msg-bubble">
                    Welcome, Shopify Owner. <br><br>
                    Did you know that <strong>80% of store owners</strong> are flying blind? They don't know when a competitor drops their price until they lose the sale.
                </div>
            </div>

            <div class="msg" id="msg-2">
                <div class="msg-sender system">Vantix System</div>
                <div class="msg-bubble">
                    Vantix fixes that. We monitor your rivals 24/7. When they make a move, you know instantly.
                    <div class="mock-ui">
                        <div class="mock-header" style="color: var(--red);"><span>🚨 Competitor Alert</span><span>Just Now</span></div>
                        <div class="mock-row"><span style="color: var(--text2);">Boandtee Shorts</span><span class="mock-val" style="color: var(--green);">$35.00</span></div>
                        <div class="mock-row"><span style="color: var(--text2);">Previous Price</span><span class="mock-val" style="text-decoration: line-through;">$45.00</span></div>
                    </div>
                </div>
            </div>

            <div class="msg" id="msg-3">
                <div class="msg-sender system">Vantix System</div>
                <div class="msg-bubble">
                    But we don't just spy. We protect your money. Our <strong>AI Margin Advisor</strong> does the math so you don't accidentally destroy your profit.
                    <div class="mock-ui">
                        <div class="mock-header" style="color: var(--violet);"><span>🧠 AI Strategy</span><span>Groq</span></div>
                        <div style="font-size: 11px; color: #fff; line-height: 1.5;">"HOLD—matching their $35 price will wipe out your margin. Instead, bundle with a Gym Bag to justify your $45 price."</div>
                    </div>
                </div>
            </div>

            <div class="msg" id="msg-4">
                <div class="msg-sender system">Vantix System</div>
                <div class="msg-bubble">
                    When you're ready to expand, our <strong>Global Catalog Search</strong> finds high-demand products before they saturate the market.
                </div>
            </div>

            <div class="msg" id="msg-5">
                <div class="msg-sender system">Vantix System</div>
                <div class="msg-bubble" style="border-color: var(--cyan); background: rgba(0, 229, 255, 0.05);">
                    <strong style="color: var(--cyan);">SYSTEM READY.</strong><br>
                    Authenticate with Google to initiate your dashboard.
                </div>
            </div>

            <!-- Typing Indicator -->
            <div class="typing-indicator" id="typing">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE - LOGIN -->
    <div class="login-container">
        <div class="login-box">
            <h1>Secure Login</h1>
            <p>Authorize Vantix to sync your Shopify data and begin tracking your market.</p>

            <button id="login-btn" class="google-btn">
                <img id="btn-icon" src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google">
                <span id="btn-text">Sign in with Google</span>
            </button>

            <div id="error-msg" class="error-msg"></div>
        </div>
    </div>

<script>
    // --- 1. AUTO-SCROLL CHAT LOGIC ---
    const messages = [1, 2, 3, 4, 5];
    const chatBox = document.getElementById('chat-box');
    const typingIndicator = document.getElementById('typing');
    const chatStatus = document.querySelector('.chat-status');

    function scrollToBottom() {
        chatBox.scrollTo({
            top: chatBox.scrollHeight,
            behavior: 'smooth'
        });
    }

    async function playChatSequence() {
        // Initial delay
        await new Promise(r => setTimeout(r, 800));
        chatStatus.innerText = "ONLINE";

        for (let i = 0; i < messages.length; i++) {
            const msgId = messages[i];
            const msgEl = document.getElementById('msg-' + msgId);
            
            // Show typing indicator
            typingIndicator.classList.add('show');
            scrollToBottom();

            // Wait for "typing" duration based on message length
            await new Promise(r => setTimeout(r, 1200 + (i * 200)));

            // Hide typing indicator, show message
            typingIndicator.classList.remove('show');
            msgEl.classList.add('show');
            
            // Scroll to bottom to show the new message
            scrollToBottom();

            // Pause before next message
            await new Promise(r => setTimeout(r, 1500));
        }
    }

    // Start chat on load
    window.addEventListener('load', playChatSequence);

    // --- 2. SUPABASE AUTH LOGIC ---
    document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById('login-btn');
        const btnText = document.getElementById('btn-text');
        const btnIcon = document.getElementById('btn-icon');
        const errorMsg = document.getElementById('error-msg');

        if (!window.supabase) {
            errorMsg.style.display = 'block';
            errorMsg.innerText = "Error: Supabase failed to load.";
            return;
        }

        const SUPABASE_URL = "https://odvusqxvhgyfoiyooktl.supabase.co";
        const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9kdnVzcXh2aGd5Zm9peW9va3RsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI5Mzk3NzAsImV4cCI6MjEwODUxNTc3MH0.5LlYHzs4iHz7gQMCLLBCDT7deMveYpx-8fabCH5AljU";

        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        btn.addEventListener('click', async () => {
            try {
                btn.disabled = true;
                btnText.innerText = "Authenticating...";
                btnIcon.style.display = 'none';
                errorMsg.style.display = 'none';

                const { data, error } = await supabase.auth.signInWithOAuth({
                    provider: 'google',
                    options: {
                        redirectTo: 'https://robelceo.github.io/vantix-ui/index.html',
                        skipBrowserRedirect: false
                    }
                });

                if (error) throw error;
            } catch (error) {
                btn.disabled = false;
                btnText.innerText = "Sign in with Google";
                btnIcon.style.display = 'block';
                errorMsg.style.display = 'block';
                errorMsg.innerText = "Login failed: " + error.message;
            }
        });
    });
</script>
</body>
</html>



